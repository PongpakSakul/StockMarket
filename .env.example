# ===========================================
# Stock Portfolio Tracker - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values

# --- PostgreSQL ---
POSTGRES_USER=portfolio_user
POSTGRES_PASSWORD=portfolio_pass
POSTGRES_DB=stock_portfolio
POSTGRES_HOST=postgres
POSTGRES_PORT=5433
DATABASE_URL=postgresql://portfolio_user:portfolio_pass@postgres:5432/stock_portfolio

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# --- Backend ---
BACKEND_PORT=3001
NODE_ENV=development

# --- Frontend ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# --- Google Cloud Vision API (OCR) ---
GOOGLE_CLOUD_VISION_API_KEY=your_google_cloud_vision_api_key_here

# --- Financial API (Yahoo Finance / Alpha Vantage / Finnhub) ---
FINANCIAL_API_KEY=your_financial_api_key_here
FINANCIAL_API_BASE_URL=https://api.example.com

# --- Exchange Rate API ---
EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key_here
EXCHANGE_RATE_API_BASE_URL=https://api.exchangerate.example.com
