{
  "name": "stock-portfolio-tracker-backend",
  "version": "1.0.0",
  "description": "Stock Portfolio Tracker - Backend API (Express + TypeScript)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --poll --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/ --ext .ts",
    "lint:fix": "eslint src/ --ext .ts --fix"
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "cors": "2.8.5",
    "express": "4.21.2",
    "helmet": "8.1.0",
    "morgan": "1.10.0",
    "multer": "^2.1.1",
    "openai": "^6.44.0",
    "pg": "^8.21.0",
    "yahoo-finance2": "^3.15.2"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "5.0.2",
    "@types/jest": "29.5.14",
    "@types/morgan": "1.9.9",
    "@types/multer": "^2.1.0",
    "@types/node": "22.15.21",
    "@types/pg": "^8.20.0",
    "@types/supertest": "6.0.2",
    "@typescript-eslint/eslint-plugin": "8.33.0",
    "@typescript-eslint/parser": "8.33.0",
    "eslint": "9.27.0",
    "fast-check": "3.23.2",
    "jest": "29.7.0",
    "supertest": "7.1.0",
    "ts-jest": "29.3.4",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "typescript": "5.8.3"
  }
}
